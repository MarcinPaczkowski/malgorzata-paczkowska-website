---
import { Image } from 'astro:assets';
import { siteConfig } from '../data/site';
// Pełnowymiarowy oryginał logo — astro:assets generuje z niego wariant
// w rozmiarze nagłówka. Ikony w public/ powstają z tego samego pliku.
import logo from '../assets/logo.png';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header
  id="site-header"
  class="sticky top-0 z-50 border-b-2 border-divider bg-canvas transition-[box-shadow] duration-200"
>
  <div class="flex items-center justify-between gap-8 px-6 py-5 sm:px-14">
    <a
      href="/"
      class="flex items-center gap-3 text-[17px] font-extrabold tracking-[-0.02em] text-ink no-underline"
    >
      <Image
        src={logo}
        alt=""
        height={36}
        densities={[1, 2]}
        loading="eager"
        class="h-9 w-auto shrink-0"
      />
      {siteConfig.name}
    </a>
    <nav aria-label="Główna nawigacja" class="hidden items-center gap-7 text-sm font-medium md:flex">
      {siteConfig.nav.map((item) => {
        const itemPath = item.href.replace(/\/$/, '') || '/';
        const active = itemPath === '/' ? path === '/' : path.startsWith(itemPath);
        return (
          <a
            href={item.href}
            aria-current={active ? 'page' : undefined}
            class={`no-underline pb-1 ${active ? 'border-b-2 border-accent text-accent-700' : 'text-ink hover:text-accent-700'}`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
    <a class="btn btn-primary hidden md:inline-flex" href="/kontakt">Umów wizytę</a>

    {/* Na mobile pasek jest wypełniony przez logo i nazwisko — CTA przenosi się
        do rozwijanego menu, a tutaj zostaje sam przycisk. */}
    <button
      id="nav-toggle"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
      {/* 44×44 to minimalny cel dotykowy; ujemny margines cofa nadmiarową
          szerokość, żeby kreski zostały wyrównane do krawędzi paska. */}
      class="-mr-[11px] flex h-11 w-11 flex-col items-center justify-center gap-[4px] md:hidden"
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>
  </div>

  <nav id="mobile-nav" aria-label="Główna nawigacja" hidden class="md:hidden">
    {siteConfig.nav.map((item) => {
      const itemPath = item.href.replace(/\/$/, '') || '/';
      const active = itemPath === '/' ? path === '/' : path.startsWith(itemPath);
      return (
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          class={`block border-t-2 border-divider px-6 py-4 text-base font-medium no-underline ${active ? 'text-accent-700' : 'text-ink'}`}
        >
          {item.label}
        </a>
      );
    })}
    <div class="border-t-2 border-divider px-6 py-5">
      <a class="btn btn-primary w-full" href="/kontakt">Umów wizytę</a>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const onScroll = () => {
      header.classList.toggle('scrolled', window.scrollY > 0);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
    };

    toggle.addEventListener('click', () => setOpen(panel.hidden));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        toggle.focus();
      }
    });

    // Po przejściu na desktop panel znika przez `md:hidden`, ale stan trzeba
    // zresetować — inaczej aria-expanded kłamie, a menu wraca otwarte po
    // ponownym zwężeniu okna.
    const desktop = window.matchMedia('(min-width: 768px)');
    desktop.addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
